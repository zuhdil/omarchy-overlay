# claude itself is NOT a package. omarchy-mise-install writes a ~/.local/bin
# wrapper that pins and runs it through mise, which is how Omarchy ships every
# tool that updates itself faster than a distro package can follow. module.sh
# calls it when neither PATH nor ~/.local/bin has a claude.
#
# mise-bin, not mise: /usr/bin/mise here is owned by mise-bin from the omarchy
# repo, and it is in omarchy-base.packages. Declaring "mise" would name a
# package that is not installed, and installing it would collide with mise-bin.
mise-bin

# The status line parses Claude's JSON with it, and module.sh merges
# settings.json with it. Required rather than optional (`?jq`): it is a hard
# dependency of the omarchy package itself and is in omarchy-base.packages, so
# on a machine this overlay targets the line is documentation rather than an
# install step. And there is no degraded mode to mark optional — without jq the
# status line renders an empty string.
jq
